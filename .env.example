# Copy this file to .env (local dev) — never commit a real key.
# Get your free student key at https://bharatcode.ai after registering.
# Free tier (eligible .ac.in / .edu.in students): Qwen up to 10M tokens/day,
# resetting midnight IST. Do NOT pay for Lite/Pro for this project.
BHARATCODE_API_KEY=
# Optional: override the default model (default: qwen-3.8-27b)
# BHARATCODE_MODEL=qwen-3.8-27b
# Optional: frontend only — backend URL when it is NOT served by Vercel
# (leave empty when using Vercel serverless or the local Vite proxy).
# VITE_API_URL=
